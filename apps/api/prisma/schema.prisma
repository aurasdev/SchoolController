generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  isActive     Boolean   @default(true) @map("is_active")
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  student      Student?
  teacher      Teacher?
  sessions     Session[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([roleId])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Student {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  groupId          String?  @map("group_id") @db.Uuid
  enrollmentNumber String   @unique @map("enrollment_number") @db.VarChar(50)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group            Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([groupId])
  @@map("students")
}

model Teacher {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @unique @map("user_id") @db.Uuid
  employeeNumber   String               @unique @map("employee_number") @db.VarChar(50)
  departmentId     String               @map("department_id") @db.Uuid
  displayName      String               @default("") @map("display_name") @db.VarChar(200)
  employmentStatus String               @default("Activo") @map("employment_status") @db.VarChar(20)
  department       Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments      ScheduleAssignment[]
  eligibleSubjects SubjectTeacher[]
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([departmentId])
  @@map("teachers")
}

model Subject {
  id           String               @id @default(uuid()) @db.Uuid
  code         String               @unique @db.VarChar(30)
  name         String               @db.VarChar(150)
  description  String?              @db.Text
  departmentId String?              @map("department_id") @db.Uuid
  department   Department?          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  planEntries  StudyPlanSubject[]
  teachers     SubjectTeacher[]
  assignments  ScheduleAssignment[]
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@index([departmentId])
  @@map("subjects")
}

model Group {
  id               String               @id @default(uuid()) @db.Uuid
  academicPeriodId String               @map("academic_period_id") @db.Uuid
  code             String               @db.VarChar(30)
  name             String               @db.VarChar(100)
  departmentId     String               @map("department_id") @db.Uuid
  semester         Int                  @default(1)
  studyPlanId      String?              @map("study_plan_id") @db.Uuid
  studyPlan        StudyPlan?           @relation(fields: [studyPlanId], references: [id], onDelete: SetNull)
  department       Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  academicPeriod   AcademicPeriod       @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)
  students         Student[]
  assignments      ScheduleAssignment[]
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@unique([id, academicPeriodId])
  @@unique([code, academicPeriodId])
  @@index([academicPeriodId])
  @@index([departmentId])
  @@index([studyPlanId])
  @@map("academic_groups")
}

model Classroom {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique @db.VarChar(30)
  name        String               @db.VarChar(100)
  capacity    Int?
  location    String?              @db.VarChar(150)
  building    String               @default("Edificio A") @db.VarChar(100)
  type        String               @default("standard") @db.VarChar(30)
  equipment   String[]             @default([])
  status      String               @default("available") @db.VarChar(30)
  assignments ScheduleAssignment[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@map("classrooms")
}

model AcademicPeriod {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @unique @db.VarChar(100)
  startsOn    DateTime             @map("starts_on") @db.Date
  endsOn      DateTime             @map("ends_on") @db.Date
  isActive    Boolean              @default(false) @map("is_active")
  groups      Group[]
  schedules   Schedule[]
  assignments ScheduleAssignment[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@map("academic_periods")
}

model Schedule {
  id               String               @id @default(uuid()) @db.Uuid
  academicPeriodId String               @map("academic_period_id") @db.Uuid
  name             String               @db.VarChar(100)
  academicPeriod   AcademicPeriod       @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)
  assignments      ScheduleAssignment[]
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@unique([id, academicPeriodId])
  @@unique([name, academicPeriodId])
  @@index([academicPeriodId])
  @@map("schedules")
}

model ScheduleAssignment {
  id               String         @id @default(uuid()) @db.Uuid
  scheduleId       String         @map("schedule_id") @db.Uuid
  academicPeriodId String         @map("academic_period_id") @db.Uuid
  subjectId        String         @map("subject_id") @db.Uuid
  teacherId        String         @map("teacher_id") @db.Uuid
  groupId          String         @map("group_id") @db.Uuid
  classroomId      String         @map("classroom_id") @db.Uuid
  dayOfWeek        DayOfWeek      @map("day_of_week")
  startTime        DateTime       @map("start_time") @db.Time(0)
  endTime          DateTime       @map("end_time") @db.Time(0)
  status           String         @default("Active") @db.VarChar(20)
  schedule         Schedule       @relation(fields: [scheduleId, academicPeriodId], references: [id, academicPeriodId], onDelete: Cascade)
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher          Teacher        @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  group            Group          @relation(fields: [groupId, academicPeriodId], references: [id, academicPeriodId], onDelete: Restrict)
  classroom        Classroom      @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([scheduleId, academicPeriodId])
  @@index([subjectId])
  @@index([teacherId, academicPeriodId, dayOfWeek])
  @@index([groupId, academicPeriodId, dayOfWeek])
  @@index([classroomId, academicPeriodId, dayOfWeek])
  @@map("schedule_assignments")
}

model Department {
  id         String      @id @default(uuid()) @db.Uuid
  code       String      @unique @db.VarChar(30)
  name       String      @unique @db.VarChar(100)
  teachers   Teacher[]
  subjects   Subject[]
  groups     Group[]
  studyPlans StudyPlan[]

  @@map("departments")
}

model AcademicActivity {
  id        String   @id @default(uuid()) @db.Uuid
  title     String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("academic_activities")
}

// Single-row table (id is always 1): global scheduling rules edited from Configuración.
model SchedulingSettings {
  id                 Int      @id @default(1)
  shiftRulesEnabled  Boolean  @default(false) @map("shift_rules_enabled")
  morningSemesters   Int[]    @default([1, 2]) @map("morning_semesters")
  afternoonSemesters Int[]    @default([3, 4, 5, 6, 7, 8, 9, 10]) @map("afternoon_semesters")
  morningStart       String   @default("08:00") @map("morning_start") @db.VarChar(5)
  afternoonStart     String   @default("14:30") @map("afternoon_start") @db.VarChar(5)
  dayEnd             String   @default("22:00") @map("day_end") @db.VarChar(5)
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("scheduling_settings")
}

// A career can have several study plans (e.g. 2020 and 2024); each groups' plan decides which
// semester a subject belongs to, so the same subject can be 5th semester in one plan and 7th in another.
model StudyPlan {
  id           String             @id @default(uuid()) @db.Uuid
  departmentId String             @map("department_id") @db.Uuid
  year         Int
  name         String             @db.VarChar(100)
  department   Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  subjects     StudyPlanSubject[]
  groups       Group[]
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@unique([departmentId, year])
  @@map("study_plans")
}

// Teachers allowed to teach a subject. No rows: any teacher of the career; one row: only that teacher.
model SubjectTeacher {
  subjectId String  @map("subject_id") @db.Uuid
  teacherId String  @map("teacher_id") @db.Uuid
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([subjectId, teacherId])
  @@index([teacherId])
  @@map("subject_teachers")
}

model StudyPlanSubject {
  id          String    @id @default(uuid()) @db.Uuid
  studyPlanId String    @map("study_plan_id") @db.Uuid
  subjectId   String    @map("subject_id") @db.Uuid
  semester    Int
  studyPlan   StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([studyPlanId, subjectId])
  @@index([subjectId])
  @@map("study_plan_subjects")
}
