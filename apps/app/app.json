{
  "expo": {
    "name": "School Controller",
    "slug": "school-controller",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "schoolcontroller",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
